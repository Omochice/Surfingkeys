{
  "name": "@sk/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:dev": "wxt build --mode development",
    "build:dev:firefox": "wxt build --mode development -b firefox",
    "build:prod": "wxt build",
    "build:prod:firefox": "wxt build -b firefox",
    "check": "npm-run-all2 --parallel --aggregate-output check:*",
    "check:oxfmt": "oxfmt --check",
    "check:oxlint": "oxlint",
    "check:package": "sort-package-json --check",
    "check:type": "tsc --noEmit -p tsconfig.browser.json",
    "check:type-node": "tsc --noEmit -p tsconfig.node.json",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "fmt": "npm-run-all2 --parallel --aggregate-output fmt:*",
    "fmt:oxfmt": "oxfmt",
    "fmt:package": "sort-package-json",
    "postinstall": "wxt prepare",
    "measure:bundle-size": "node measure-bundle-size.mjs",
    "test": "vitest run",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@praha/byethrow": "catalog:",
    "@sk/background": "workspace:*",
    "@sk/common": "workspace:*",
    "@sk/content": "workspace:*",
    "@sk/core": "workspace:*",
    "@sk/messaging": "workspace:*"
  },
  "devDependencies": {
    "@sk/test-support": "workspace:*",
    "@sk/types": "workspace:*",
    "@types/chrome": "catalog:",
    "@types/firefox-webext-browser": "catalog:",
    "@types/node": "25.9.4",
    "@wxt-dev/module-solid": "1.1.4",
    "jsdom": "catalog:",
    "lightningcss": "1.32.0",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rollup-plugin-visualizer": "7.0.1",
    "sharp": "0.35.2",
    "solid-js": "catalog:",
    "sort-package-json": "catalog:",
    "typescript": "catalog:",
    "vite": "8.1.1",
    "vitest": "catalog:",
    "wxt": "catalog:"
  }
}
