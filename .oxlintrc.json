{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/refs/tags/oxlint_v1.80.0/npm/oxlint/configuration_schema.json",
  "ignorePatterns": ["src/content_scripts/gist.js", "src/content_scripts/common/debug_utils.js"],
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-this-alias": "off",
    "typescript/consistent-type-assertions": ["warn", { "assertionStyle": "never" }],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "no-unused-expressions": ["error", { "allowShortCircuit": true, "allowTernary": true }],
    "no-underscore-dangle": "error",
    "no-restricted-properties": [
      "error",
      {
        "property": "call",
        "message": "Avoid Function.prototype.call; call the function or method directly."
      },
      {
        "property": "bind",
        "message": "Avoid Function.prototype.bind; prefer an arrow closure, e.g. () => fn(arg)."
      }
    ],
    "curly": ["error", "multi-line"],
    "unicorn/no-array-sort": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-string-slice": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-date-now": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/consistent-existence-index-check": "error",
    "unicorn/custom-error-definition": "error",
    "unicorn/import-style": "error",
    "unicorn/no-console-spaces": "error",
    "unicorn/no-nested-ternary": "error",
    "unicorn/no-zero-fractions": "error",
    "unicorn/prefer-default-parameters": "error",
    "unicorn/text-encoding-identifier-case": "error",
    "unicorn/escape-case": "error",
    "unicorn/prefer-dom-node-dataset": "error",
    "unicorn/no-await-expression-member": "error",
    "unicorn/prefer-modern-dom-apis": "error",
    "unicorn/no-instanceof-builtins": "error",
    "unicorn/catch-error-name": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/prefer-regexp-test": "error",
    "unicorn/no-anonymous-default-export": "error",
    "unicorn/no-array-reduce": "error",
    "unicorn/prefer-string-raw": "error",
    "unicorn/prefer-at": "error",
    "unicorn/switch-case-braces": "error",
    "unicorn/prefer-logical-operator-over-ternary": "error",
    "unicorn/no-lonely-if": "error",
    "unicorn/prefer-negative-index": "error",
    "unicorn/numeric-separators-style": "error",
    "unicorn/no-static-only-class": "error"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "overrides": [
    {
      "files": ["**/globals.d.ts", "**/dom-augmentations.d.ts"],
      "rules": {
        "typescript/consistent-type-definitions": "off"
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-restricted-properties": "off",
        "typescript/consistent-type-assertions": "off"
      }
    }
  ]
}
