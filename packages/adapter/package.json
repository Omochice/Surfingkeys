{
  "name": "@sk/adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check": "npm-run-all2 check:*",
    "check:oxfmt": "oxfmt --check",
    "check:oxlint": "oxlint",
    "check:package": "sort-package-json --check",
    "check:type": "tsc --noEmit -p tsconfig.json",
    "fmt": "npm-run-all2 fmt:*",
    "fmt:oxfmt": "oxfmt",
    "fmt:package": "sort-package-json",
    "test": "vitest run"
  },
  "dependencies": {
    "@sk/core": "workspace:*"
  },
  "devDependencies": {
    "@sk/test-support": "workspace:*",
    "@sk/types": "workspace:*",
    "@types/chrome": "catalog:",
    "@types/firefox-webext-browser": "catalog:",
    "jsdom": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sort-package-json": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
