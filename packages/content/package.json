{
  "name": "@sk/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "check": "npm-run-all2 --parallel --aggregate-output check:*",
    "check:oxfmt": "oxfmt --check",
    "check:oxlint": "oxlint",
    "check:package": "sort-package-json --check",
    "check:type": "tsc --noEmit -p tsconfig.json",
    "fmt": "npm-run-all2 --parallel --aggregate-output fmt:*",
    "fmt:oxfmt": "oxfmt",
    "fmt:package": "sort-package-json",
    "test": "vitest run",
    "test:browser": "vitest run -c vitest.browser.config.ts"
  },
  "dependencies": {
    "@praha/byethrow": "catalog:",
    "@sk/adapter": "workspace:*",
    "@sk/common": "workspace:*",
    "@sk/core": "workspace:*",
    "@sk/messaging": "workspace:*",
    "solid-js": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@sk/test-support": "workspace:*",
    "@sk/types": "workspace:*",
    "@solidjs/testing-library": "0.8.10",
    "@types/chrome": "catalog:",
    "@types/firefox-webext-browser": "catalog:",
    "@vitest/browser-playwright": "4.1.10",
    "jsdom": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "1.61.1",
    "sort-package-json": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-solid": "2.11.12",
    "vitest": "catalog:"
  }
}
