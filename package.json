{
  "name": "Surfingkeys",
  "version": "1.18.0",
  "description": "Map your keys for web surfing, expand your browser with javascript and keyboard.",
  "homepage": "https://github.com/Omochice/Surfingkeys#readme",
  "bugs": {
    "url": "https://github.com/Omochice/Surfingkeys/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Omochice/Surfingkeys.git"
  },
  "license": "MIT",
  "author": "Omochice",
  "type": "module",
  "scripts": {
    "build": "pnpm build:prod",
    "build:dev": "pnpm --filter @sk/extension build:dev",
    "build:dev:firefox": "pnpm --filter @sk/extension build:dev:firefox",
    "build:prod": "pnpm --filter @sk/extension build:prod",
    "build:prod:firefox": "pnpm --filter @sk/extension build:prod:firefox",
    "check": "npm-run-all2 --parallel --aggregate-output check:*",
    "check:knip": "knip",
    "check:nixfmt": "nixfmt --check flake.nix",
    "check:oxfmt": "oxfmt --check vitest.config.ts",
    "check:oxlint": "oxlint vitest.config.ts",
    "check:package": "sort-package-json --check",
    "check:rumdl": "rumdl check .",
    "check:toml-sort": "toml-sort --check --all .rumdl.toml _typos.toml",
    "check:typos": "typos",
    "check:workspaces": "pnpm -r run check",
    "coverage": "vitest run --coverage",
    "dev": "pnpm --filter @sk/extension dev",
    "dev:firefox": "pnpm --filter @sk/extension dev:firefox",
    "fmt": "npm-run-all2 --parallel --aggregate-output fmt:*",
    "fmt:nixfmt": "nixfmt flake.nix",
    "fmt:oxfmt": "oxfmt vitest.config.ts",
    "fmt:package": "sort-package-json",
    "fmt:rumdl": "rumdl check --fix .",
    "fmt:toml-sort": "toml-sort --in-place --all .rumdl.toml _typos.toml",
    "fmt:workspaces": "pnpm -r run fmt",
    "measure:bundle-size": "pnpm --filter @sk/extension run measure:bundle-size",
    "test": "pnpm -r run test",
    "test:browser": "pnpm --filter @sk/content run test:browser",
    "test:watch": "vitest",
    "zip": "pnpm --filter @sk/extension zip",
    "zip:firefox": "pnpm --filter @sk/extension zip:firefox"
  },
  "devDependencies": {
    "@tsconfig/strictest": "2.0.8",
    "@vitest/coverage-istanbul": "4.1.10",
    "knip": "6.29.0",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sort-package-json": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    }
  }
}
